<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderCanvasBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="?attr/ereaderNavTranslucentBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnChaptersBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/ereaderTextPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/chapters_title" />

                <TextView
                    android:id="@+id/tvEbookChaptersHeaderSub"
                    style="@style/TextAppearance.EReader.LabelMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportEbookMetadataJson"
                style="@style/Widget.EReader.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:minHeight="36dp"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="4dp"
                android:text="@string/action_import_metadata_json"
                android:textSize="12sp"
                app:cornerRadius="@dimen/radius_pill"
                app:icon="@drawable/ic_folder"
                app:iconSize="14dp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="168dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space_base">

                <!-- Book Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EReader.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_base">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="112dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivEbookSummaryCover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/artwork_plum"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_cover_vignette" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:minHeight="112dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEbookSummaryTitle"
                                style="@style/TextAppearance.EReader.HeadlineLg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2" />

                            <TextView
                                android:id="@+id/tvEbookSummaryMeta"
                                style="@style/TextAppearance.EReader.BodySm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvEbookSummaryPercent"
                                    style="@style/TextAppearance.EReader.LabelMd"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_sm"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorPrimary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvEbookSummaryPages"
                                    style="@style/TextAppearance.EReader.LabelMd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressEbookSummary"
                                style="@style/Widget.EReader.ProgressBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Segmented Tab Switcher -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_rounded_container"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookChapters"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:textSize="12sp"
                        app:cornerRadius="@dimen/radius_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookBookmarks"
                        style="@style/Widget.EReader.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:textColor="?attr/ereaderTextSecondary"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookNotes"
                        style="@style/Widget.EReader.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:textColor="?attr/ereaderTextSecondary"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:background="@drawable/bg_search_input"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/search_bar_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_md">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/ereaderTextMuted" />

                    <EditText
                        android:id="@+id/etEbookChapterSearch"
                        style="@style/TextAppearance.EReader.BodySm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/chapters_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="@dimen/search_bar_height"
                        android:textColor="?attr/ereaderTextPrimary"
                        android:textColorHint="?attr/ereaderTextMuted" />
                </LinearLayout>

                <!-- Active Chapter Highlighted Card -->
                <LinearLayout
                    android:id="@+id/cardActiveEbookChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:background="@drawable/bg_card_active_chapter"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_primary" />

                        <TextView
                            android:id="@+id/tvActiveChapterStatus"
                            style="@style/TextAppearance.EReader.LabelBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tvActiveChapterBadge"
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_default"
                            android:paddingHorizontal="@dimen/space_sm"
                            android:paddingVertical="2dp"
                            android:textColor="?attr/ereaderTextAccent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveChapterTitle"
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="@string/chapter_progress_label" />

                        <TextView
                            android:id="@+id/tvActiveChapterProgress"
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressActiveChapter"
                        style="@style/Widget.EReader.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResumeChapter"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:minHeight="@dimen/button_height_secondary"
                        android:paddingHorizontal="@dimen/space_base"
                        android:paddingVertical="@dimen/space_sm"
                        android:text="@string/action_resume_reading"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textEnd"
                        app:iconSize="16dp"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEbookTreeControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEbookTreeSummary"
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextMuted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEbookToggleExpandAll"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="@string/chapters_expand_all"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEbookChaptersEmpty"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:padding="@dimen/space_base"
                    android:text="@string/chapters_empty_items"
                    android:visibility="gone" />

                <!-- Dynamic List Container -->
                <LinearLayout
                    android:id="@+id/containerEbookChapters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Bottom Dock (Mini-Player + Floating Continue Pill) -->
    <LinearLayout
        android:id="@+id/bottomDockEbookChapters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm">

            <include layout="@layout/layout_mini_player" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutBottomCurrentChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_hud"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_sm"
            android:paddingStart="@dimen/space_base"
            android:paddingEnd="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.EReader.LabelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_chapter"
                    android:textColor="?attr/ereaderTextMuted" />

                <TextView
                    android:id="@+id/tvBottomCurrentChapter"
                    style="@style/TextAppearance.EReader.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/ereaderTextPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueFromIndex"
                style="@style/Widget.EReader.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height_secondary"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:text="@string/action_continue"
                app:cornerRadius="@dimen/radius_pill"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
