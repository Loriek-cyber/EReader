<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_base"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="@color/surface_nav_translucent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnChaptersBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/chapters_title" />

                <TextView
                    style="@style/TextAppearance.EReader.LabelMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sample_book_1984_header" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="116dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space_base">

                <!-- Book Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EReader.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_base">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="112dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/artwork_plum"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/cover_1984"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_cover_vignette" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:minHeight="112dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.EReader.HeadlineLg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/sample_book_1984_title" />

                            <TextView
                                style="@style/TextAppearance.EReader.BodySm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/chapters_book_meta_sample" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.EReader.LabelMd"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_sm"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/chapters_progress_percent_sample"
                                    android:textColor="@color/primary_fixed_dim"
                                    android:textStyle="bold" />

                                <TextView
                                    style="@style/TextAppearance.EReader.LabelMd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="@string/chapters_page_progress_sample" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                style="@style/Widget.EReader.ProgressBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:progress="68" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Segmented Tab Switcher -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_rounded_container"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookChapters"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:text="@string/tab_chapters"
                        android:textSize="12sp"
                        app:cornerRadius="@dimen/radius_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookBookmarks"
                        style="@style/Widget.EReader.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:text="@string/tab_bookmarks_ebook"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabEbookNotes"
                        style="@style/Widget.EReader.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingVertical="@dimen/space_xs"
                        android:text="@string/tab_notes_ebook"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:background="@drawable/bg_search_input"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/search_bar_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_md">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_placeholder" />

                    <EditText
                        android:id="@+id/etEbookChapterSearch"
                        style="@style/TextAppearance.EReader.BodySm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/chapters_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="@dimen/search_bar_height"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_placeholder" />
                </LinearLayout>

                <!-- Parte Prima Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/part_one" />

                    <TextView
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_container"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="3dp"
                        android:text="@string/part_one_range_sample" />
                </LinearLayout>

                <!-- Completed Chapters Sample -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical">

                    <include layout="@layout/item_chapter_ebook" />
                    <include layout="@layout/item_chapter_ebook" />
                </LinearLayout>

                <!-- Active Chapter Highlighted Card (Cap. V) -->
                <LinearLayout
                    android:id="@+id/cardActiveEbookChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/space_xs"
                    android:background="@drawable/bg_card_active_chapter"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_primary" />

                        <TextView
                            style="@style/TextAppearance.EReader.LabelBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="@string/chapter_active_status_sample"
                            android:textColor="@color/primary" />

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_default"
                            android:paddingHorizontal="@dimen/space_sm"
                            android:paddingVertical="2dp"
                            android:text="@string/chapter_active_badge_sample"
                            android:textColor="@color/text_lavender" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/reader_chapter_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="@string/chapter_progress_label" />

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chapter_progress_read_sample"
                            android:textColor="@color/primary_fixed_dim"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        style="@style/Widget.EReader.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:progress="68" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResumeChapter"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:minHeight="@dimen/button_height_secondary"
                        android:paddingHorizontal="@dimen/space_base"
                        android:paddingVertical="@dimen/space_sm"
                        android:text="@string/action_resume_reading"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textEnd"
                        app:iconSize="16dp"
                        app:iconTint="@color/on_primary_container" />
                </LinearLayout>

                <!-- Remaining Chapters -->
                <include layout="@layout/item_chapter_ebook" />

                <!-- Parte Seconda Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:alpha="0.4"
                        android:background="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/part_two" />

                    <TextView
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_container"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="3dp"
                        android:text="@string/part_two_range_sample" />
                </LinearLayout>

                <include layout="@layout/item_chapter_ebook" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Floating Bottom Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_floating_hud"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_sm"
        android:paddingStart="@dimen/space_base"
        android:paddingEnd="@dimen/space_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.EReader.LabelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_chapter"
                android:textColor="@color/text_muted" />

            <TextView
                style="@style/TextAppearance.EReader.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/chapters_current_summary_sample"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueFromIndex"
            style="@style/Widget.EReader.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height_secondary"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_sm"
            android:text="@string/action_continue"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconSize="18dp"
            app:iconTint="@color/on_primary_container" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
