<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderCanvasBg"
    android:fitsSystemWindows="true">

    <!-- Subtle Ambient Nocturnal Glow -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-100dp"
        android:alpha="0.5"
        android:background="@drawable/bg_ambient_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Reader App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="?attr/ereaderNavTranslucentBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnReaderBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/ereaderTextPrimary" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnChapterPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:background="@drawable/bg_chip_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_xs">

                    <View
                        android:id="@+id/dotChapterPill"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_primary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvReaderChapterPill"
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_sm"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextAccent"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivChapterPillChevron"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@id/dotChapterPill"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivChapterPillChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_expand_more"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/ereaderTextMuted" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnReaderStop"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_stop_session"
                android:padding="12dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/error" />
        </LinearLayout>

        <!-- Primary Reading Sanctuary Canvas -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollReaderContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="220dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space_base">

                <!-- Chapter Display Intro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"
                            android:background="@color/border_active" />

                        <TextView
                            android:id="@+id/tvReaderChapterLabel"
                            style="@style/TextAppearance.EReader.LabelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_sm"
                            android:letterSpacing="0.22"
                            android:textColor="?attr/ereaderTextAccent" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"
                            android:background="@color/border_active" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReaderChapterTitle"
                        style="@style/TextAppearance.EReader.HeadlineLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:textStyle="italic|bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/colorPrimaryContainer" />
                </LinearLayout>

                <!-- Dynamic Text Content (EPUB / TXT) -->
                <TextView
                    android:id="@+id/tvReaderProseBody"
                    style="@style/TextAppearance.EReader.ReaderProse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Dynamic PDF Page Renderer Section -->
                <LinearLayout
                    android:id="@+id/layoutPdfContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivPdfPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:background="@color/white"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPdfPrevPage"
                            style="@style/Widget.EReader.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/reader_prev_page" />

                        <TextView
                            android:id="@+id/tvPdfPageIndicator"
                            style="@style/TextAppearance.EReader.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_base" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPdfNextPage"
                            style="@style/Widget.EReader.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/reader_next_page" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Chapter Navigation & Completion Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevChapterReader"
                        style="@style/Widget.EReader.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/reader_prev_chapter" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompleteChapterReader"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_base"
                        android:text="@string/reader_complete_chapter"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textEnd"
                        app:iconSize="16dp"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Floating Ergonomic Reader Controls Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="vertical">

        <!-- Collapsible Typography Quick HUD -->
        <LinearLayout
            android:id="@+id/typographyHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:background="@drawable/bg_floating_hud"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/reader_font_size_label"
                    android:textColor="?attr/ereaderTextMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontDecrease"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/cd_font_decrease"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="0dp"
                    android:text="@string/reader_font_decrease"
                    app:cornerRadius="@dimen/radius_sm" />

                <TextView
                    android:id="@+id/tvFontSizeLabel"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:textColor="?attr/ereaderTextAccent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontIncrease"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/cd_font_increase"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="0dp"
                    android:text="@string/reader_font_increase"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontSerif"
                    style="@style/Widget.EReader.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="@dimen/space_xs"
                    android:text="@string/reader_font_serif"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontSans"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="@dimen/space_xs"
                    android:text="@string/reader_font_sans"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThemeOled"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="@dimen/space_xs"
                    android:text="@string/reader_theme_oled"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Floating Dock -->
        <LinearLayout
            android:id="@+id/readerControlsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_hud"
            android:elevation="14dp"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs">

                <TextView
                    android:id="@+id/tvReaderPageCounter"
                    style="@style/TextAppearance.EReader.LabelMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/ereaderTextAccent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReaderProgressPercent"
                    style="@style/TextAppearance.EReader.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressReader"
                style="@style/Widget.EReader.ProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_sm"
                android:layout_marginTop="6dp" />

            <!-- Quick Reader Action Tray -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnActionTypography"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xxs"
                    android:paddingVertical="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reader_font_aa" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/reader_hud_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnActionTheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xxs"
                    android:paddingVertical="@dimen/space_xs">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brightness"
                        app:tint="?attr/ereaderTextPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/reader_hud_theme" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnActionIndex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xxs"
                    android:paddingVertical="@dimen/space_xs">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_book_open"
                        app:tint="?attr/ereaderTextPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/reader_hud_index" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnActionBookmark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xxs"
                    android:paddingVertical="@dimen/space_xs">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bookmark_filled"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/reader_hud_save"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
