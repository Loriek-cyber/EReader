<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAudioChapterRow"
        style="@style/Widget.EReader.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:clickable="true"
        android:focusable="true"
        app:rippleColor="@color/glow_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_md"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_surface">

                <ImageView
                    android:id="@+id/ivAudioChapterIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvAudioChapterNum"
                    style="@style/TextAppearance.EReader.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:text="06" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAudioChapterTitle"
                    style="@style/TextAppearance.EReader.BodyMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/ereaderTextPrimary"
                    android:textStyle="bold"
                    tools:text="Capitolo 1: Il tele-schermo" />

                <TextView
                    android:id="@+id/tvAudioChapterMeta"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="24 min • Completato" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAudioChapterExpand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_expand_section"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_more"
                android:visibility="gone"
                app:tint="?attr/ereaderTextMuted" />

            <ImageButton
                android:id="@+id/btnAudioChapterAction"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_play_chapter"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play_circle"
                app:tint="?attr/ereaderTextMuted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recursive subtree container for nested sections and subsections -->
    <LinearLayout
        android:id="@+id/layoutAudioChapterChildrenWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/viewAudioChapterTreeGuide"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_xxs"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="?attr/ereaderBorderSubtle" />

        <LinearLayout
            android:id="@+id/containerAudioChapterChildren"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
