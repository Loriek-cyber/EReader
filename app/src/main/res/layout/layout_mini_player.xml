<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_hud"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_sm"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMiniCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/artwork_plum"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Thumb" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_card" />

        <ImageView
            android:id="@+id/ivMiniTypeIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_equalizer"
            app:tint="@color/primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMiniTitle"
            style="@style/TextAppearance.EReader.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/ereaderTextPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMiniSubtitle"
            style="@style/TextAppearance.EReader.LabelMd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMiniRewind"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_rewind_15"
        android:padding="13dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_replay_15"
        app:tint="?attr/ereaderTextSecondary" />

    <ImageButton
        android:id="@+id/btnMiniPlayPause"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginHorizontal="@dimen/space_xxs"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="@string/cd_play_pause"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_pause"
        app:tint="@color/on_primary_container" />

    <ImageButton
        android:id="@+id/btnMiniStop"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_stop_session"
        android:padding="13dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock"
        app:tint="@color/error" />
</LinearLayout>
