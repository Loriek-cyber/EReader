<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderSurfaceBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="?attr/ereaderNavTranslucentBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_sm">

            <ImageButton
                android:id="@+id/btnAudioChaptersBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/ereaderTextPrimary" />

            <TextView
                android:id="@+id/tvAudioChaptersTitle"
                style="@style/TextAppearance.EReader.HeadlineSm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="108dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space_sm">

                <!-- Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAudioChapters"
                            style="@style/Widget.EReader.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:insetTop="6dp"
                            android:insetBottom="6dp"
                            android:minHeight="@dimen/touch_target_min"
                            android:paddingHorizontal="@dimen/space_base"
                            android:textSize="13sp"
                            app:cornerRadius="@dimen/radius_pill"
                            app:icon="@drawable/ic_book_open"
                            app:iconSize="16dp"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAudioBookmarks"
                            style="@style/Widget.EReader.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:insetTop="6dp"
                            android:insetBottom="6dp"
                            android:minHeight="@dimen/touch_target_min"
                            android:paddingHorizontal="@dimen/space_base"
                            android:textColor="?attr/ereaderTextMuted"
                            android:textSize="13sp"
                            app:backgroundTint="?attr/ereaderChipBg"
                            app:cornerRadius="@dimen/radius_pill"
                            app:icon="@drawable/ic_bookmark"
                            app:iconSize="16dp"
                            app:iconTint="?attr/ereaderTextMuted" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAudioNotes"
                            style="@style/Widget.EReader.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="6dp"
                            android:insetBottom="6dp"
                            android:minHeight="@dimen/touch_target_min"
                            android:paddingHorizontal="@dimen/space_base"
                            android:textColor="?attr/ereaderTextMuted"
                            android:textSize="13sp"
                            app:backgroundTint="?attr/ereaderChipBg"
                            app:cornerRadius="@dimen/radius_pill"
                            app:icon="@drawable/ic_note"
                            app:iconSize="16dp"
                            app:iconTint="?attr/ereaderTextMuted" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_search_input"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/search_bar_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_md">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/ereaderTextMuted" />

                    <EditText
                        android:id="@+id/etAudioChapterSearch"
                        style="@style/TextAppearance.EReader.BodyMd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/chapters_audio_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="@dimen/search_bar_height"
                        android:textColor="?attr/ereaderTextPrimary"
                        android:textColorHint="?attr/ereaderTextMuted" />
                </LinearLayout>

                <!-- Overall Listening Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EReader.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/TextAppearance.EReader.BodySm"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_xs"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/chapters_audio_listening_progress"
                                android:textColor="?attr/ereaderTextMuted" />

                            <TextView
                                android:id="@+id/tvAudioOverallPercent"
                                style="@style/TextAppearance.EReader.BodySm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressAudioOverall"
                            style="@style/Widget.EReader.ProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Audio Chapter Card -->
                <LinearLayout
                    android:id="@+id/cardActiveAudioChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:background="@drawable/bg_card_active_chapter"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_primary"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_equalizer"
                            app:tint="@color/on_primary_container" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvActiveChapterBadge"
                                    style="@style/TextAppearance.EReader.LabelBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_lavender"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="@string/player_now_playing"
                                    android:textColor="@color/primary_fixed"
                                    app:layout_constrainedWidth="true"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/tvActiveChapterTime"
                                    app:layout_constraintHorizontal_bias="0.0"
                                    app:layout_constraintHorizontal_chainStyle="packed"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/tvActiveChapterTime"
                                    style="@style/TextAppearance.EReader.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorPrimary"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/tvActiveChapterBadge"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:id="@+id/tvAudioActiveChapterTitle"
                                style="@style/TextAppearance.EReader.HeadlineSm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnActiveChapterPause"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:background="@drawable/bg_circle_primary"
                            android:contentDescription="@string/cd_play_pause"
                            android:padding="14dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_play"
                            app:tint="@color/on_primary_container" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressAudioActiveChapter"
                        style="@style/Widget.EReader.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAudioTreeControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAudioTreeSummary"
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextMuted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAudioToggleExpandAll"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="@string/chapters_expand_all"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAudioChaptersEmpty"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:padding="@dimen/space_base"
                    android:text="@string/chapters_empty_items"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerAudioChapters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/space_base">

        <include layout="@layout/layout_mini_player" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
