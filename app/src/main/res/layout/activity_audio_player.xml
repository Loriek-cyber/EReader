<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderSurfaceBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_screen">

        <ImageButton
            android:id="@+id/btnPlayerCollapse"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_collapse_player"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/ereaderTextPrimary" />

        <TextView
            style="@style/TextAppearance.EReader.LabelBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:text="@string/player_now_playing"
            android:textColor="?attr/ereaderTextMuted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnPlayerStop"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_stop_session"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="@color/error" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingBottom="@dimen/space_base">

            <!-- Central Artwork Stage -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="308dp"
                android:paddingVertical="@dimen/space_xs">

                <View
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ambient_glow" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EReader.Card.Elevated"
                    android:layout_width="230dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPlayerCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/artwork_plum"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cover_vignette" />

                        <!-- Audio Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="@dimen/space_md"
                            android:background="@drawable/bg_chip_default"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_primary" />

                            <TextView
                                style="@style/TextAppearance.EReader.LabelBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/player_hd_badge"
                                android:textColor="?attr/ereaderTextAccent"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Bookmark Button -->
                        <ImageButton
                            android:id="@+id/btnPlayerBookmark"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="@dimen/space_sm"
                            android:background="@drawable/bg_circle_surface"
                            android:contentDescription="@string/cd_add_bookmark"
                            android:padding="14dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_bookmark"
                            app:tint="?attr/ereaderTextAccent" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Track Information & Chapter Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_default"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_equalizer"
                        app:tint="?attr/colorSecondary" />

                    <TextView
                        android:id="@+id/tvPlayerChapterPill"
                        style="@style/TextAppearance.EReader.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextAccent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    style="@style/TextAppearance.EReader.DisplayLg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvPlayerAuthor"
                    style="@style/TextAppearance.EReader.BodyMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/ereaderTextSecondary" />
            </LinearLayout>

            <!-- Timeline Scrubber -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderAudioProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_audio_progress"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:thumbColor="?attr/ereaderTextPrimary"
                    app:thumbRadius="7dp"
                    app:trackColorActive="?attr/colorPrimaryContainer"
                    app:trackColorInactive="?attr/ereaderTrackNeutral"
                    app:trackHeight="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xs">

                    <TextView
                        android:id="@+id/tvPlayerElapsed"
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextAccent"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayerRemaining"
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="?attr/ereaderTextMuted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary Playback Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_md"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- -15s -->
                <LinearLayout
                    android:id="@+id/btnSkipBack15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/cd_rewind_15"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_replay_15"
                        app:tint="?attr/ereaderTextSecondary" />

                    <TextView
                        style="@style/TextAppearance.EReader.LabelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/player_skip_15s"
                        android:textAllCaps="false"
                        android:textColor="?attr/ereaderTextMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Previous Chapter -->
                <ImageButton
                    android:id="@+id/btnPrevChapter"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_previous_chapter"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="?attr/ereaderTextPrimary" />

                <!-- Play / Pause -->
                <ImageButton
                    android:id="@+id/btnPlayPauseMain"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="@dimen/space_md"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/cd_play_pause"
                    android:elevation="8dp"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play"
                    app:tint="@color/on_primary_container" />

                <!-- Next Chapter -->
                <ImageButton
                    android:id="@+id/btnNextChapter"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_next_chapter"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="?attr/ereaderTextPrimary" />

                <!-- +30s -->
                <LinearLayout
                    android:id="@+id/btnSkipForward30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/cd_forward_30"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_forward_30"
                        app:tint="?attr/ereaderTextSecondary" />

                    <TextView
                        style="@style/TextAppearance.EReader.LabelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/player_skip_30s"
                        android:textAllCaps="false"
                        android:textColor="?attr/ereaderTextMuted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Secondary Tools Bar -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_xs">

                    <LinearLayout
                        android:id="@+id/btnPlayerSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <TextView
                            android:id="@+id/tvPlayerSpeed"
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_default"
                            android:paddingHorizontal="@dimen/space_sm"
                            android:paddingVertical="2dp"
                            android:textColor="?attr/colorSecondary"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/player_speed_label" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="?attr/ereaderBorderSubtle" />

                    <LinearLayout
                        android:id="@+id/btnPlayerSleepTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_moon"
                            app:tint="?attr/ereaderTextAccent" />

                        <TextView
                            android:id="@+id/tvPlayerTimer"
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/player_timer_off" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="?attr/ereaderBorderSubtle" />

                    <LinearLayout
                        android:id="@+id/btnPlayerChapters"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_list"
                            app:tint="?attr/ereaderTextAccent" />

                        <TextView
                            style="@style/TextAppearance.EReader.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/action_chapters" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
