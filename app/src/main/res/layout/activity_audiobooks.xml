<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAudiobooks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="168dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_base">

            <TextView
                style="@style/TextAppearance.EReader.DisplayLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audiobooks_title" />

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:minHeight="@dimen/search_bar_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_placeholder" />

                <EditText
                    android:id="@+id/etAudioSearch"
                    style="@style/TextAppearance.EReader.BodySm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/audiobooks_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="@dimen/search_bar_height"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_placeholder" />
            </LinearLayout>

            <!-- Hero Header: In Riproduzione -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_circle"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/audiobooks_now_playing" />

                <TextView
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audiobooks_current_device"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Active Audio Player Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAudioHero"
                style="@style/Widget.EReader.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="176dp"
                        android:layout_height="176dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-48dp"
                        android:layout_marginEnd="-48dp"
                        android:background="@drawable/bg_ambient_glow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="128dp">

                            <!-- Cover Artwork with Badge -->
                            <FrameLayout
                                android:id="@+id/layoutAudioHeroCover"
                                android:layout_width="96dp"
                                android:layout_height="128dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivAudioHeroCover"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/artwork_plum"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/cover_1984"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_cover_vignette" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="6dp"
                                    android:background="@drawable/bg_circle_surface"
                                    android:contentDescription="@null"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_headphones"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/TextAppearance.EReader.LabelBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|start"
                                    android:layout_margin="6dp"
                                    android:text="@string/audiobooks_badge_audio_edition"
                                    android:textColor="@color/text_lavender"
                                    android:textSize="9sp" />
                            </FrameLayout>

                            <!-- Content Info -->
                            <LinearLayout
                                android:id="@+id/layoutHeroMeta"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:orientation="vertical"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/layoutAudioHeroCover"
                                app:layout_constraintTop_toTopOf="parent">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:id="@+id/tvHeroChapterBadge"
                                        style="@style/TextAppearance.EReader.LabelBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_lavender"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="@string/audiobooks_hero_chapter_sample"
                                        android:textColor="@color/text_lavender"
                                        app:layout_constrainedWidth="true"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toStartOf="@id/tvHeroChapterTime"
                                        app:layout_constraintHorizontal_bias="0.0"
                                        app:layout_constraintHorizontal_chainStyle="packed"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:id="@+id/tvHeroChapterTime"
                                        style="@style/TextAppearance.EReader.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_xs"
                                        android:maxLines="1"
                                        android:text="@string/audiobooks_hero_time_sample"
                                        android:textColor="@color/text_muted"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toEndOf="@id/tvHeroChapterBadge"
                                        app:layout_constraintTop_toTopOf="parent" />
                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <TextView
                                    style="@style/TextAppearance.EReader.HeadlineLg"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/sample_book_1984_title" />

                                <TextView
                                    style="@style/TextAppearance.EReader.BodySm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/sample_book_1984_author" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_voice"
                                        app:tint="@color/primary" />

                                    <TextView
                                        style="@style/TextAppearance.EReader.Caption"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_xs"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/audiobooks_hero_narrator_sample"
                                        android:textColor="@color/primary" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/layoutAudioHeroCover"
                                app:layout_constraintTop_toBottomOf="@id/layoutHeroMeta"
                                app:layout_constraintVertical_bias="1.0">

                                <LinearLayout
                                    android:id="@+id/btnAudioHeroChapters"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:minHeight="@dimen/touch_target_min"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="@dimen/space_xs">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_list"
                                        app:tint="@color/text_secondary" />

                                    <TextView
                                        style="@style/TextAppearance.EReader.LabelMd"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_xs"
                                        android:text="@string/action_chapters"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <ImageButton
                                    android:id="@+id/btnHeroPlayPause"
                                    android:layout_width="@dimen/touch_target_min"
                                    android:layout_height="@dimen/touch_target_min"
                                    android:background="@drawable/bg_circle_primary"
                                    android:contentDescription="@string/cd_play_pause"
                                    android:padding="13dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_pause"
                                    app:tint="@color/on_primary_container" />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Scrubber & Timers -->
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            style="@style/Widget.EReader.ProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_base"
                            android:progress="34" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/primary" />

                            <TextView
                                style="@style/TextAppearance.EReader.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginEnd="@dimen/space_xs"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/audiobooks_hero_progress_sample" />

                            <TextView
                                style="@style/TextAppearance.EReader.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/audiobooks_hero_remaining_sample"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Tutti gli audiolibri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_library"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/audiobooks_all_title" />

                <TextView
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/audiobooks_count_sample"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Audiobook List (Sample rows matching Stitch) -->
            <LinearLayout
                android:id="@+id/listAudiobooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <include
                    android:id="@+id/itemAudiobook1"
                    layout="@layout/item_audiobook_row" />
                <include
                    android:id="@+id/itemAudiobook2"
                    layout="@layout/item_audiobook_row" />
                <include
                    android:id="@+id/itemAudiobook3"
                    layout="@layout/item_audiobook_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Mini-Player Floating Bar -->
    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_floating_hud"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/artwork_plum"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/cover_1984"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Thumb" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/scrim_card" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_equalizer"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.EReader.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/audiobooks_mini_title_sample"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.EReader.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/audiobooks_mini_subtitle_sample" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMiniRewind"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_rewind_15"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_replay_15"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginHorizontal="@dimen/space_xxs"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/cd_play_pause"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pause"
            app:tint="@color/on_primary_container" />

        <ImageButton
            android:id="@+id/btnMiniForward"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_forward_30"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward_30"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Bottom Navigation Dock -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
