<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderSurfaceBg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAudiobooks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="168dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_base">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.EReader.DisplayLg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/audiobooks_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportAudio"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="4dp"
                    android:text="@string/audiobooks_import_btn"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_pill"
                    app:icon="@drawable/ic_folder"
                    app:iconSize="14dp" />
            </LinearLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:minHeight="@dimen/search_bar_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/ereaderTextMuted" />

                <EditText
                    android:id="@+id/etAudioSearch"
                    style="@style/TextAppearance.EReader.BodySm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/audiobooks_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="@dimen/search_bar_height"
                    android:textColor="?attr/ereaderTextPrimary"
                    android:textColorHint="?attr/ereaderTextMuted" />

                <ImageButton
                    android:id="@+id/btnClearAudioSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="?attr/ereaderTextMuted" />
            </LinearLayout>

            <!-- Hero Section: In Riproduzione (Visible when an audiobook is in progress) -->
            <LinearLayout
                android:id="@+id/sectionAudioNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_circle"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/audiobooks_now_playing" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audiobooks_current_device"
                        android:textColor="?attr/ereaderTextMuted" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAudioHero"
                    style="@style/Widget.EReader.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="176dp"
                            android:layout_height="176dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-48dp"
                            android:layout_marginEnd="-48dp"
                            android:background="@drawable/bg_ambient_glow" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_base">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="128dp">

                                <FrameLayout
                                    android:id="@+id/layoutAudioHeroCover"
                                    android:layout_width="96dp"
                                    android:layout_height="128dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/ivAudioHeroCover"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/artwork_plum"
                                        android:contentDescription="@null"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/bg_cover_vignette" />

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="top|end"
                                        android:layout_margin="6dp"
                                        android:background="@drawable/bg_circle_surface"
                                        android:contentDescription="@null"
                                        android:padding="5dp"
                                        android:src="@drawable/ic_headphones"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        style="@style/TextAppearance.EReader.LabelBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="bottom|start"
                                        android:layout_margin="6dp"
                                        android:text="@string/audiobooks_badge_audio_edition"
                                        android:textColor="@color/text_lavender"
                                        android:textSize="9sp" />
                                </FrameLayout>

                                <LinearLayout
                                    android:id="@+id/layoutHeroMeta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:orientation="vertical"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/layoutAudioHeroCover"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:id="@+id/tvHeroChapterBadge"
                                            style="@style/TextAppearance.EReader.LabelBadge"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/bg_badge_lavender"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:paddingHorizontal="6dp"
                                            android:paddingVertical="2dp"
                                            android:textColor="@color/text_lavender"
                                            app:layout_constrainedWidth="true"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            app:layout_constraintEnd_toStartOf="@id/tvHeroChapterTime"
                                            app:layout_constraintHorizontal_bias="0.0"
                                            app:layout_constraintHorizontal_chainStyle="packed"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toTopOf="parent" />

                                        <TextView
                                            android:id="@+id/tvHeroChapterTime"
                                            style="@style/TextAppearance.EReader.Caption"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="@dimen/space_xs"
                                            android:maxLines="1"
                                            android:textColor="?attr/ereaderTextMuted"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toEndOf="@id/tvHeroChapterBadge"
                                            app:layout_constraintTop_toTopOf="parent" />
                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                    <TextView
                                        android:id="@+id/tvAudioHeroTitle"
                                        style="@style/TextAppearance.EReader.HeadlineLg"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_xs"
                                        android:ellipsize="end"
                                        android:maxLines="1" />

                                    <TextView
                                        android:id="@+id/tvAudioHeroAuthor"
                                        style="@style/TextAppearance.EReader.BodySm"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1" />

                                    <LinearLayout
                                        android:id="@+id/layoutAudioHeroNarrator"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <ImageView
                                            android:layout_width="14dp"
                                            android:layout_height="14dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_voice"
                                            app:tint="?attr/colorPrimary" />

                                        <TextView
                                            android:id="@+id/tvAudioHeroNarrator"
                                            style="@style/TextAppearance.EReader.Caption"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="@dimen/space_xs"
                                            android:layout_weight="1"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:textColor="?attr/colorPrimary" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/layoutAudioHeroCover"
                                    app:layout_constraintTop_toBottomOf="@id/layoutHeroMeta"
                                    app:layout_constraintVertical_bias="1.0">

                                    <LinearLayout
                                        android:id="@+id/btnAudioHeroChapters"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="?attr/selectableItemBackground"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center_vertical"
                                        android:minHeight="@dimen/touch_target_min"
                                        android:orientation="horizontal"
                                        android:paddingHorizontal="@dimen/space_xs">

                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_list"
                                            app:tint="?attr/ereaderTextSecondary" />

                                        <TextView
                                            style="@style/TextAppearance.EReader.LabelMd"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="@dimen/space_xs"
                                            android:text="@string/action_chapters"
                                            android:textColor="?attr/ereaderTextSecondary" />
                                    </LinearLayout>

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <ImageButton
                                        android:id="@+id/btnHeroPlayPause"
                                        android:layout_width="@dimen/touch_target_min"
                                        android:layout_height="@dimen/touch_target_min"
                                        android:background="@drawable/bg_circle_primary"
                                        android:contentDescription="@string/cd_play_pause"
                                        android:padding="13dp"
                                        android:scaleType="centerInside"
                                        android:src="@drawable/ic_play"
                                        app:tint="@color/on_primary_container" />
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressAudioHero"
                                style="@style/Widget.EReader.ProgressBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_base" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_clock"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:id="@+id/tvAudioHeroProgressLabel"
                                    style="@style/TextAppearance.EReader.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_xs"
                                    android:layout_marginEnd="@dimen/space_xs"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1" />

                                <TextView
                                    android:id="@+id/tvAudioHeroRemaining"
                                    style="@style/TextAppearance.EReader.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textColor="?attr/ereaderTextMuted" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Section: Tutti gli audiolibri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_library"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/audiobooks_all_title" />

                <TextView
                    android:id="@+id/tvAudiobooksCount"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="?attr/ereaderTextMuted" />
            </LinearLayout>

            <!-- No search results state -->
            <TextView
                android:id="@+id/tvAudioNoResults"
                style="@style/TextAppearance.EReader.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:padding="@dimen/space_xl"
                android:text="@string/search_no_results"
                android:textColor="?attr/ereaderTextMuted"
                android:visibility="gone" />

            <!-- Empty state -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutAudioEmpty"
                style="@style/Widget.EReader.Card.Low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_headphones"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:text="@string/audiobooks_empty_title" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center"
                        android:text="@string/audiobooks_empty_desc" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyImportAudio"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_lg"
                        android:text="@string/audiobooks_import_btn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dynamic Audiobook List -->
            <LinearLayout
                android:id="@+id/listAudiobooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomDockAudiobooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:layout_marginBottom="@dimen/space_sm">

            <include layout="@layout/layout_mini_player" />
        </FrameLayout>

        <include
            android:id="@+id/includeBottomNav"
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
