<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ereaderSurfaceBg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="168dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_base">

            <!-- Header Eyebrow & Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_dot_primary" />

                <TextView
                    style="@style/TextAppearance.EReader.LabelBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/library_eyebrow"
                    android:textColor="?attr/ereaderTextMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportEbook"
                    style="@style/Widget.EReader.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="4dp"
                    android:text="@string/library_import_btn"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_pill"
                    app:icon="@drawable/ic_folder"
                    app:iconSize="14dp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.EReader.HeadlineLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/library_title" />

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:minHeight="@dimen/search_bar_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/ereaderTextMuted" />

                <EditText
                    android:id="@+id/etLibrarySearch"
                    style="@style/TextAppearance.EReader.BodySm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/library_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="@dimen/search_bar_height"
                    android:textColor="?attr/ereaderTextPrimary"
                    android:textColorHint="?attr/ereaderTextMuted" />

                <ImageButton
                    android:id="@+id/btnClearLibrarySearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="?attr/ereaderTextMuted" />
            </LinearLayout>

            <!-- Section: In Corso (Visible only when an in-progress book exists in DB) -->
            <LinearLayout
                android:id="@+id/sectionLibraryInProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.EReader.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/library_in_progress" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardContinueReading"
                    style="@style/Widget.EReader.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-48dp"
                            android:layout_marginEnd="-48dp"
                            android:background="@drawable/bg_ambient_glow" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivHeroCover"
                                    android:layout_width="80dp"
                                    android:layout_height="112dp"
                                    android:background="@color/artwork_plum"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_bias="0.0"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Thumb" />

                                <LinearLayout
                                    android:id="@+id/heroBadgeRow"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/ivHeroCover"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <TextView
                                        android:id="@+id/tvHeroChapterBadge"
                                        style="@style/TextAppearance.EReader.LabelBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="?attr/colorPrimary" />

                                    <TextView
                                        style="@style/TextAppearance.EReader.LabelBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginHorizontal="@dimen/space_xs"
                                        android:text="@string/symbol_bullet"
                                        android:textColor="?attr/ereaderTextMuted" />

                                    <TextView
                                        android:id="@+id/tvHeroPageCount"
                                        style="@style/TextAppearance.EReader.LabelBadge"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textAllCaps="false"
                                        android:textColor="?attr/ereaderTextMuted" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvHeroTitle"
                                    style="@style/TextAppearance.EReader.HeadlineSm"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/ivHeroCover"
                                    app:layout_constraintTop_toBottomOf="@id/heroBadgeRow" />

                                <TextView
                                    android:id="@+id/tvHeroAuthor"
                                    style="@style/TextAppearance.EReader.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/ivHeroCover"
                                    app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

                                <LinearLayout
                                    android:id="@+id/heroProgressHeader"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_marginTop="@dimen/space_sm"
                                    android:orientation="horizontal"
                                    app:layout_constraintBottom_toTopOf="@id/progressHero"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/ivHeroCover"
                                    app:layout_constraintTop_toBottomOf="@id/tvHeroAuthor"
                                    app:layout_constraintVertical_bias="1.0">

                                    <TextView
                                        style="@style/TextAppearance.EReader.Caption"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="@dimen/space_xs"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/label_progress"
                                        android:textColor="?attr/ereaderTextMuted" />

                                    <TextView
                                        android:id="@+id/tvHeroPercent"
                                        style="@style/TextAppearance.EReader.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="?attr/colorPrimary"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progressHero"
                                    style="@style/Widget.EReader.ProgressBar"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:layout_marginBottom="@dimen/space_xxs"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/ivHeroCover" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <!-- Quick Action Bar -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_base">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHeroIndex"
                                    style="@style/Widget.EReader.Button.Secondary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_sm"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:minWidth="0dp"
                                    android:minHeight="@dimen/touch_target_min"
                                    android:paddingHorizontal="@dimen/space_md"
                                    android:text="@string/action_index"
                                    app:cornerRadius="@dimen/radius_sm"
                                    app:icon="@drawable/ic_list"
                                    app:iconSize="14dp"
                                    app:layout_constrainedWidth="true"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/btnHeroResume"
                                    app:layout_constraintHorizontal_bias="0.0"
                                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:strokeWidth="0dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHeroResume"
                                    style="@style/Widget.EReader.Button.Primary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:minWidth="0dp"
                                    android:minHeight="@dimen/touch_target_min"
                                    android:paddingHorizontal="@dimen/space_base"
                                    android:text="@string/action_resume"
                                    android:textSize="12sp"
                                    app:cornerRadius="@dimen/radius_sm"
                                    app:icon="@drawable/ic_arrow_forward"
                                    app:iconGravity="textEnd"
                                    app:iconSize="14dp"
                                    app:iconTint="@color/white"
                                    app:layout_constrainedWidth="true"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/btnHeroIndex"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Section Header: La tua Collezione -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNextSectionTitle"
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_next_section" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_primary" />

                        <TextView
                            style="@style/TextAppearance.EReader.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:text="@string/library_next_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLibraryCount"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/ereaderTextMuted" />
            </LinearLayout>

            <!-- No search results state -->
            <TextView
                android:id="@+id/tvLibraryNoResults"
                style="@style/TextAppearance.EReader.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:padding="@dimen/space_xl"
                android:text="@string/search_no_results"
                android:textColor="?attr/ereaderTextMuted"
                android:visibility="gone" />

            <!-- Empty State when no books in SQLite -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutLibraryEmpty"
                style="@style/Widget.EReader.Card.Low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_book_open"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/TextAppearance.EReader.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:text="@string/library_empty_title" />

                    <TextView
                        style="@style/TextAppearance.EReader.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center"
                        android:text="@string/library_empty_desc" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyImportEbook"
                        style="@style/Widget.EReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/space_lg"
                        android:text="@string/library_import_btn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dynamic 2-Column Book Grid -->
            <LinearLayout
                android:id="@+id/gridLibraryBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomDockLibrary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:layout_marginBottom="@dimen/space_sm">

            <include layout="@layout/layout_mini_player" />
        </FrameLayout>

        <include
            android:id="@+id/includeBottomNav"
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
