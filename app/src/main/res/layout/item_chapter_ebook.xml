<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChapterRow"
        style="@style/Widget.EReader.Card.Low"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:clickable="true"
        android:focusable="true"
        app:rippleColor="@color/glow_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_sm"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:id="@+id/ivChapterStatus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChapterTitle"
                    style="@style/TextAppearance.EReader.BodyMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/ereaderTextPrimary"
                    android:textStyle="bold"
                    tools:text="Capitolo I" />

                <TextView
                    android:id="@+id/tvChapterSubtitle"
                    style="@style/TextAppearance.EReader.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Il grande occhio del tele-schermo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChapterPage"
                style="@style/TextAppearance.EReader.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xxs"
                android:maxLines="1"
                tools:text="Pag. 5" />

            <ImageButton
                android:id="@+id/btnChapterExpand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_expand_section"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_more"
                android:visibility="gone"
                app:tint="?attr/ereaderTextMuted" />

            <ImageView
                android:id="@+id/ivChapterChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/ereaderTextMuted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recursive subtree container for nested sections and subsections -->
    <LinearLayout
        android:id="@+id/layoutChapterChildrenWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/viewChapterTreeGuide"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_xxs"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="?attr/ereaderBorderSubtle" />

        <LinearLayout
            android:id="@+id/containerChapterChildren"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
