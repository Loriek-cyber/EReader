<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EReader.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/glow_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_sm">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBookCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/artwork_plum"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover"
            tools:src="@drawable/cover_gatsby" />

        <TextView
            android:id="@+id/tvBookTitle"
            style="@style/TextAppearance.EReader.BodyMd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBookCover"
            tools:text="Il Grande Gatsby" />

        <TextView
            android:id="@+id/tvBookAuthor"
            style="@style/TextAppearance.EReader.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookTitle"
            tools:text="F. Scott Fitzgerald" />

        <TextView
            android:id="@+id/tvBookStatusLabel"
            style="@style/TextAppearance.EReader.LabelMd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/tvBookStatusValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookAuthor"
            tools:text="Stato" />

        <TextView
            android:id="@+id/tvBookStatusValue"
            style="@style/TextAppearance.EReader.LabelMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvBookStatusLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Completato" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBook"
            style="@style/Widget.EReader.ProgressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookStatusLabel"
            app:trackThickness="@dimen/progress_track_height_sm"
            tools:progress="100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookAction"
            style="@style/Widget.EReader.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="@dimen/touch_target_min"
            app:cornerRadius="@dimen/radius_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBook"
            tools:text="Rileggi" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
