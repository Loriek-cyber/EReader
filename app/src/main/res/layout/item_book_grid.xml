<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EReader.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/glow_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBookCover"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@color/artwork_plum"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.EReader.Cover"
            tools:src="@drawable/cover_gatsby" />

        <TextView
            android:id="@+id/tvBookTitle"
            style="@style/TextAppearance.EReader.BodyMd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="Il Grande Gatsby" />

        <TextView
            android:id="@+id/tvBookAuthor"
            style="@style/TextAppearance.EReader.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="F. Scott Fitzgerald" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookStatusLabel"
                style="@style/TextAppearance.EReader.LabelMd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Stato" />

            <TextView
                android:id="@+id/tvBookStatusValue"
                style="@style/TextAppearance.EReader.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textStyle="bold"
                tools:text="Completato" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBook"
            style="@style/Widget.EReader.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:progress="100"
            app:trackThickness="@dimen/progress_track_height_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookAction"
            style="@style/Widget.EReader.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/space_md"
            tools:text="Rileggi" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
