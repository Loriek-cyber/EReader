        <item name="ereaderTextSecondary">@color/sepia_text_secondary</item>
        <item name="ereaderTextMuted">@color/sepia_text_muted</item>
        <item name="ereaderTextAccent">@color/sepia_text_accent</item>
        <item name="ereaderBorderSubtle">@color/sepia_border_subtle</item>
        <item name="ereaderBorderGlass">@color/sepia_border_glass</item>
        <item name="ereaderTrackNeutral">@color/sepia_track_neutral</item>

        <item name="android:colorBackground">@color/sepia_surface</item>
        <item name="android:windowBackground">@color/sepia_surface</item>
        <item name="android:statusBarColor">@color/sepia_nav</item>
