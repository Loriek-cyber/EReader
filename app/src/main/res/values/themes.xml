        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/light_primary</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/light_text_secondary</item>
        <item name="colorSurfaceContainerLow">@color/light_container_low</item>
        <item name="colorSurfaceContainer">@color/light_container</item>

        <item name="ereaderCanvasBg">@color/light_canvas</item>
        <item name="ereaderSurfaceBg">@color/light_surface</item>
        <item name="ereaderNavBg">@color/light_nav</item>
        <item name="ereaderNavTranslucentBg">@color/light_nav_translucent</item>
        <item name="ereaderCardBg">@color/light_card</item>
        <item name="ereaderCardElevatedBg">@color/light_card</item>
        <item name="ereaderContainerLowBg">@color/light_container_low</item>
        <item name="ereaderContainerBg">@color/light_container</item>
        <item name="ereaderFloatingGlassBg">@color/light_floating_glass</item>
        <item name="ereaderChipBg">@color/light_container</item>
        <item name="ereaderTextPrimary">@color/light_text_primary</item>
        <item name="ereaderTextSecondary">@color/light_text_secondary</item>
        <item name="ereaderTextMuted">@color/light_text_muted</item>
        <item name="ereaderTextAccent">@color/light_text_accent</item>
        <item name="ereaderBorderSubtle">@color/light_border_subtle</item>
        <item name="ereaderBorderGlass">@color/light_border_glass</item>
        <item name="ereaderTrackNeutral">@color/light_track_neutral</item>

        <item name="android:colorBackground">@color/light_surface</item>
        <item name="android:windowBackground">@color/light_surface</item>
        <item name="android:statusBarColor">@color/light_nav</item>
        <item name="android:navigationBarColor">@color/light_nav</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Warm Sepia Reading Theme -->
    <style name="Theme.EReader.Sepia" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sepia_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sepia_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/sepia_primary</item>
        <item name="colorSurface">@color/sepia_surface</item>
        <item name="colorOnSurface">@color/sepia_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/sepia_text_secondary</item>
        <item name="colorSurfaceContainerLow">@color/sepia_container_low</item>
